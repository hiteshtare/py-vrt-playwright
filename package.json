{
  "name": "py-vrt-playwright-english",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "allure:clear": "rm -r allure-results/** && cp -r allure-reports/history/ allure-results && rm -r allure-reports/**",
    "allure:report": "allure generate allure-results --name 'PlayWright_Demo' --clean -o allure-reports",
    "test:baseline": "NODE_ENV=release npx playwright test",
    "pretest:compare": "npm run allure:clear",
    "test:compare": "NODE_ENV=staging npx playwright test || npm run posttest:compare",
    "posttest:compare": "npm run allure:report",
    "test:update-baseline": "NODE_ENV=release npx playwright test --update-snapshots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiteshtare/py-vrt-playwright-english.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hiteshtare/py-vrt-playwright-english/issues"
  },
  "homepage": "https://github.com/hiteshtare/py-vrt-playwright-english#readme",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/dateformat": "^5.0.3",
    "@types/node": "^24.10.0",
    "allure-playwright": "^3.4.2",
    "dateformat": "^5.0.3",
    "log4js": "^6.9.1"
  },
  "dependencies": {
    "@types/google-spreadsheet": "^3.3.2",
    "@types/lodash": "^4.17.21",
    "@visual-regression-tracker/agent-playwright": "^5.3.1",
    "dotenv": "^17.2.3",
    "google-auth-library": "^9.15.1",
    "google-spreadsheet": "^4.1.4",
    "lodash": "^4.17.21",
    "write-json-file": "^6.0.0"
  }
}
